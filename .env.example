# Taproot configuration — keep byte-for-byte in sync with ARCHITECTURE.md §10.
# A missing required var must fail at startup with a named error, never at first use.

# --- Core ---
TAPROOT_ENV=development                                   # development|staging|production
TAPROOT_DATABASE_URL=postgresql+asyncpg://taproot:taproot@localhost:5432/taproot
TAPROOT_REDIS_URL=redis://localhost:6379/0
TAPROOT_LOG_LEVEL=INFO

# --- Auth ---
TAPROOT_KEYCLOAK_URL=http://localhost:8080
TAPROOT_KEYCLOAK_REALM=taproot
TAPROOT_KEYCLOAK_AUDIENCE=taproot-api

# --- Secrets ---
TAPROOT_SECRET_STORE=local                                # vault|local
TAPROOT_VAULT_ADDR=
TAPROOT_VAULT_TOKEN=
TAPROOT_LOCAL_SECRET_KEY=dev-only-change-me               # required when SECRET_STORE=local

# --- LLM ---
TAPROOT_LLM_BASE_URL=http://vllm:8001/v1
TAPROOT_LLM_MODEL=Qwen2.5-Coder-32B-Instruct
TAPROOT_LLM_TIMEOUT_S=120

# --- GitLab (platform-level, for group discovery) ---
TAPROOT_GITLAB_URL=https://gitlab.internal
TAPROOT_GITLAB_TOKEN=                                     # read_api scope ONLY

# --- Agent tuning ---
TAPROOT_AGENT_MAX_TOKENS=120000
TAPROOT_AGENT_NODE_TIMEOUT_S=45
TAPROOT_AGENT_MAX_DURATION_S=300
TAPROOT_AGENT_MAX_THREADS=5
TAPROOT_AGENT_CONCURRENCY=5

# --- Retention ---
TAPROOT_INVESTIGATION_RETENTION_DAYS=90

# --- Observability ---
TAPROOT_SERVICE_NAME=taproot-api
TAPROOT_OTEL_ENABLED=false
TAPROOT_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend (Vite; public client — no secrets) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_AUTHORITY=http://localhost:8080/realms/taproot
VITE_KEYCLOAK_CLIENT_ID=taproot-web
